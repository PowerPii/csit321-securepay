# Public server settings for deploy/compose.prod.yaml. make-secrets.sh copies this file to
# deploy/.env (git-ignored) on the first run; then edit DOMAIN and ACME_EMAIL there.

# Either a real domain whose DNS has A records for gateway, shop and mail pointing at the
# server (the live server: DOMAIN=securepaysg.me since 19 Nov 2026), or the server's public
# IPv4 with dashes plus .sslip.io (no sign-up; resolves to that IP): for 203.0.113.5 the
# names become gateway.203-0-113-5.sslip.io, shop..., mail...
# To change it on a running server, use deploy/change-domain.sh (RUNBOOK.md 13a).
DOMAIN=203-0-113-5.sslip.io

# The previous domain, set by change-domain.sh: its gateway., shop. and mail. names answer
# with a 308 redirect to the new ones. Empty = no redirects.
OLD_DOMAIN=

# Optional: the server's public IPv4, for the smoke check's "port 8443 closed" test and
# setup-auto-deploy.sh when DNS for a real domain is not set up yet. Unused with sslip.io.
# PUBLIC_IP=203.0.113.5

# Let's Encrypt sends certificate expiry notices here. Use a team address.
ACME_EMAIL=change-me@example.com

# Trained fraud model folder in gateway/apps/risk/model_artifacts/ (RUNBOOK.md step 6).
# Empty = stub model (rules decide).
RISK_MODEL_VERSION=
RISK_MODEL_SHA256=

# Simulator fault controls for the S4 demo (Fifa, 14 Nov 2026). Reachable only inside the
# server and only with secrets/simulator_test_control_key. 0 turns them off.
SIM_TEST_CONTROLS=1

# Demo inbox (Mailpit) basic-auth user. make-secrets.sh adds MAIL_PASSWORD_HASH below.
MAIL_USER=team

# Real email (RUNBOOK.md 13b). gateway-worker sends each email by its recipient: made-up demo
# addresses (MAIL_RELAY_BLOCKED, safe default in compose.prod.yaml: example.com,
# demoshop.sg, securepay.sg, .test ...) only to the demo inbox (Mailpit); real addresses
# straight to the provider, never copied into the demo inbox. Empty MAIL_RELAY_HOST = no
# provider: real addresses are then not sent at all (the demo-day fallback; demo addresses
# still work). The names are kept from the old Mailpit relay. After a change: docker compose
# -f deploy/compose.prod.yaml up -d gateway-worker
#   Resend: MAIL_RELAY_HOST=smtp.resend.com, MAIL_RELAY_USERNAME=resend,
#           MAIL_RELAY_PASSWORD=<API key, "Sending access" for the domain only>
#   Brevo:  MAIL_RELAY_HOST=smtp-relay.brevo.com, MAIL_RELAY_USERNAME=<SMTP login>,
#           MAIL_RELAY_PASSWORD=<SMTP key>
# Port 587 (STARTTLS) or 465 (TLS); never plain text.
# MAIL_RELAY_MATCHING is an optional allowlist, a regular expression on the recipient: empty
# or ".*" for everyone, or only the team's own inboxes for provider staging. Single quotes,
# so the $ stays as it is:
#   MAIL_RELAY_MATCHING='(?i)@(gmail\.com|uowmail\.edu\.au)$'
# MAIL_RELAY_PASSWORD is a secret: deploy/.env is readable by securepay only (chmod 600).
MAIL_RELAY_HOST=
MAIL_RELAY_PORT=587
MAIL_RELAY_USERNAME=
MAIL_RELAY_PASSWORD=
MAIL_RELAY_MATCHING=
# Resend > Webhooks > the endpoint https://gateway.<domain>/webhooks/resend > Signing secret
# (whsec_...). Lets the dashboard show "Delivered" or "Bounced" after "Accepted" (RUNBOOK.md
# 13b). Empty = the endpoint is off (404). A secret: keep deploy/.env chmod 600.
RESEND_WEBHOOK_SECRET=

# Public status page (www.<domain>/status, data at gateway.<domain>/status.json): one line
# shown at the top, for planned work. Empty = no line. Takes effect after
# `docker compose -f deploy/compose.prod.yaml up -d gateway`.
#   STATUS_NOTICE="Planned upgrade Sat 21 Nov, 10 to 10:30 pm SGT. Payments may fail briefly."
STATUS_NOTICE=

# Demo core-only mode for the prototype demonstration (RUNBOOK.md 11b): 1 hides API keys,
# Webhooks, customer accounts and the guest status link; 0 (or empty) shows everything.
# Nothing is deleted either way. Takes effect after
# `docker compose -f deploy/compose.prod.yaml up -d gateway`.
DEMO_CORE_ONLY=0

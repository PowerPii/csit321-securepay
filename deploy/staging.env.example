# Staging settings (deploy/STAGING.md), the staging clone's own deploy/.env. Made by
# deploy/staging-setup.sh; never copy production's deploy/.env here.

# Every docker compose command in the staging clone uses the staging project, even one that
# forgets -f deploy/compose.staging.yaml. Without this line the project would be called
# "deploy", like production's, and could replace production's containers. Keep it.
COMPOSE_PROJECT_NAME=securepay-staging

# gateway., shop. and mail.<DOMAIN>. DNS: A records for the three names to the server
# (STAGING.md, step 1). The production Caddy gets their certificates.
DOMAIN=staging.securepaysg.me
OLD_DOMAIN=

# Not used for certificates on staging (production's Caddy holds them), but Compose needs it.
ACME_EMAIL=change-me@example.com

# Fraud model folder in gateway/apps/risk/model_artifacts/ of this clone (staging-setup.sh
# copies production's). Empty = stub model (rules decide).
RISK_MODEL_VERSION=
RISK_MODEL_SHA256=

SIM_TEST_CONTROLS=1

# Staging demo inbox (https://mail.<DOMAIN>) basic-auth user. make-secrets.sh adds
# MAIL_PASSWORD_HASH below: a different password from production's inbox.
MAIL_USER=team

# No real email on staging. compose.staging.yaml forces these empty anyway.
MAIL_RELAY_HOST=
MAIL_RELAY_USERNAME=
MAIL_RELAY_PASSWORD=
MAIL_RELAY_MATCHING=
RESEND_WEBHOOK_SECRET=

STATUS_NOTICE="Staging: the v2 test copy, not the live service. Data may be reset at any time."
